#!/usr/bin/env python3
"""local-ai-assistant — voice → NPU Whisper → NPU LLM → TTS, all offline.

Commands:
  record SECONDS [out.wav]    capture mic audio (default 5s -> temp wav)
  transcribe audio.wav        Whisper ASR on the NPU
  ask "question"              one-shot LLM reply on the NPU
  voice [SECONDS]             record → transcribe → LLM reply (→ speak with --speak)
  chat [--voice]              interactive chat, history persists across runs
                              (--reset to wipe, --no-history for ephemeral)
  speak "text"                piper TTS playback
  status                      is the NPU server up?
  stop                        stop the NPU server
"""

import argparse
import sys
import tempfile
from pathlib import Path

from assistant import server, asr, chat, tts, record, history
from assistant.config import LLM_MODEL


def cmd_record(args):
    record.check_audio_stack()
    out = Path(args.out).expanduser() if args.out else Path(
        tempfile.mkstemp(suffix=".wav", prefix="npu-rec-")[1])
    print(f"recording {args.seconds}s mic -> {out} ...")
    record.record(args.seconds, out)
    print(f"done: {out} ({out.stat().st_size} bytes)")


def cmd_transcribe(args):
    server.ensure_flm()
    server.start_server(LLM_MODEL)
    print(asr.transcribe_text(args.file))


def cmd_ask(args):
    server.ensure_flm()
    server.start_server(LLM_MODEL)
    print(chat.chat_reply(args.question))


def cmd_voice(args):
    server.ensure_flm()
    server.start_server(LLM_MODEL)
    record.check_audio_stack()
    tmp = Path(tempfile.mkstemp(suffix=".wav", prefix="npu-voice-")[1])
    print(f"[listening {args.seconds}s ...]")
    record.record(args.seconds, tmp)
    print("[transcribing on NPU ...]")
    query = asr.transcribe_text(tmp)
    tmp.unlink(missing_ok=True)
    if asr.is_probably_noise(query):
        if query:
            print(f"(no speech detected — heard only: {query!r})")
        else:
            print("(no speech detected)")
        return
    print(f"you: {query}")
    print("[thinking on NPU ...]")
    reply = chat.chat_reply(query)
    print(f"ai:  {reply}")
    if args.speak:
        tts.speak(reply)


def cmd_speak(args):
    tts.ensure_voice()
    tts.speak(args.text)


def cmd_status(_args):
    print("server up" if server.server_up() else "server down")


def cmd_stop(_args):
    server.stop_server()
    print("stopped")


def cmd_chat(args):
    server.ensure_flm()
    server.start_server(LLM_MODEL)
    if args.reset:
        history.clear_history()
    if args.no_history:
        messages = [dict(history.SYSTEM_PROMPT)]
    else:
        messages = history.load_history()
    prior = sum(1 for m in messages if m["role"] != "system")
    banner = f"[NPU LLM {LLM_MODEL} ready — type to chat, 'exit' to quit"
    if prior:
        banner += f"; resumed {prior} earlier message(s)"
    print(banner + "]")
    while True:
        try:
            line = input("you> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if line.lower() in ("exit", "quit", "bye"):
            break
        if not line:
            continue
        messages.append({"role": "user", "content": line})
        reply = chat.chat(messages)["choices"][0]["message"]["content"].strip()
        messages.append({"role": "assistant", "content": reply})
        if not args.no_history:
            history.save_history(messages)
        print(f"ai>   {reply}")
        if args.voice:
            tts.speak(reply)


def build_parser():
    p = argparse.ArgumentParser(prog="local-ai-assistant", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    r = sub.add_parser("record", help="capture mic audio")
    r.add_argument("seconds", type=float, default=5.0, nargs="?")
    r.add_argument("out", nargs="?")
    r.set_defaults(func=cmd_record)

    t = sub.add_parser("transcribe", help="ASR a file on the NPU")
    t.add_argument("file")
    t.set_defaults(func=cmd_transcribe)

    a = sub.add_parser("ask", help="one-shot LLM question")
    a.add_argument("question")
    a.set_defaults(func=cmd_ask)

    v = sub.add_parser("voice", help="record → transcribe → LLM reply")
    v.add_argument("seconds", type=float, default=5.0, nargs="?")
    v.add_argument("--speak", action="store_true", help="speak the reply via piper")
    v.set_defaults(func=cmd_voice)

    s = sub.add_parser("speak", help="piper TTS out loud")
    s.add_argument("text")
    s.set_defaults(func=cmd_speak)

    c = sub.add_parser("chat", help="interactive NPU chat (history persists)")
    c.add_argument("--voice", action="store_true", help="speak replies via piper")
    c.add_argument("--reset", action="store_true",
                   help="wipe saved history before starting")
    c.add_argument("--no-history", action="store_true",
                   help="ephemeral session: don't load or save history")
    c.set_defaults(func=cmd_chat)

    sub.add_parser("status", help="server up?").set_defaults(func=cmd_status)
    sub.add_parser("stop", help="stop the NPU server").set_defaults(func=cmd_stop)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except RuntimeError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())